[Unit]
Description=Arm Signally Nexmon CSI capture
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/signally-csi
Environment=SIGNALLY_PROJECT_ROOT=/home/idanyo/Signally
ExecStart=/bin/bash ${SIGNALLY_PROJECT_ROOT}/backend/scripts/csi_capture.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

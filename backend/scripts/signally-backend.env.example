# Template for /etc/default/signally-backend on the Pi.
# Copy to /etc/default/signally-backend and fill in real values there.
# That file is created directly on the Pi and is NOT committed to git,
# same handling as /etc/default/signally-csi.

# Classroom CSI calibration (see docs/classroom_csi_calibration_2026-08-14.md)
SIGNALLY_CSI_BASELINE_FACTOR=1.20
SIGNALLY_CSI_DETECTION_HOLD_SECONDS=5

# Wi-Fi probing tuning
SIGNALLY_WIFI_PROBING_STRONG_RSSI_MIN=-45
SIGNALLY_WIFI_PROBING_IGNORED_MACS=<router/AP MACs to ignore, comma-separated>

# Closed-network ARP architecture: the Pi has no presence on the closed
# Wi-Fi subnet, so local ARP scanning stays disabled and the laptop agent
# (scripts/laptop_arp_agent.py) remains the only ARP path via /arp/ingest.
SIGNALLY_LOCAL_ARP_SCAN_ENABLED=false
SIGNALLY_ARP_INGEST_TOKEN=<real shared secret, never committed>
